---
import { ascentPosition, ascentFacing } from '../artwork/journey';
interface Props {
  total: number;
}
const { total } = Astro.props;
const [x, y] = ascentPosition(0);
---

<div
  class="question-journey"
  aria-hidden="true"
  data-stage="0"
  data-total={total}
>
  <svg
    viewBox="0 0 192 256"
    class="journey-desktop"
    aria-hidden="true"
    shape-rendering="crispEdges"
  >
    <use href="#journey-landscape" x="0" y="0" width="192" height="256" />
    <use href="#journey-flag" x="116" y="6" width="12" height="18" />
    <use
      href="#journey-traveler"
      x={x - 8}
      y={y - 24}
      width="16"
      height="24"
      class="journey-traveler"
      transform={
        ascentFacing(0) === -1 ? `translate(${2 * x} 0) scale(-1 1)` : undefined
      }
    />
  </svg>
  <svg
    viewBox="0 0 288 56"
    class="journey-mobile"
    aria-hidden="true"
    shape-rendering="crispEdges"
  >
    <use href="#journey-mobile-path" x="0" y="0" width="288" height="56" />
    <use
      href="#journey-traveler"
      x="12"
      y="20"
      width="16"
      height="24"
      class="journey-traveler"
    />
  </svg>
</div>
