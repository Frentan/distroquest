---
import ThemeToggle from '../components/ThemeToggle.astro';
import BrandMark from '../components/BrandMark.astro';
import JourneySymbols from '../components/JourneySymbols.astro';
import { repositoryUrl } from '../config';
import '../styles/global.css';
import {
  defaultLocale,
  getMessages,
  publishedLocales,
  type PublishedLocale,
} from '../i18n';
import {
  pageMetadata,
  publishedPagePath,
  resolvePage,
  type Page,
} from '../routing';

interface Props {
  locale?: PublishedLocale;
  page: Page;
  title: string;
  description: string;
}
const { title, description, page, locale = defaultLocale } = Astro.props;
const copy = getMessages(locale).site;
const route = resolvePage(Astro.url.pathname);
if (
  route?.page !== page ||
  route.locale !== locale ||
  !publishedPagePath(page, locale)
) {
  throw new Error('Page identity must match a published route');
}
const { canonical, alternates, noindex } = pageMetadata(
  page,
  locale,
  Astro.site,
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48 64x64 128x128 256x256"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Before paint: storage may be unavailable, but the OS preference still works. -->
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem('distroquest-theme');
        } catch {}
        const theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <JourneySymbols />
    <a class="skip-link" href="#main">
      {copy.skipLink}
    </a>
    <header class="site-header container">
      <a
        class="brand"
        href={publishedPagePath('home', locale)}
        aria-label={copy.homeLabel}
      >
        <BrandMark />
        <span>
          {copy.wordmark[0]}
          <span class="brand-quest">{copy.wordmark[1]}</span>
          <span class="brand-dot">.</span>
        </span>
      </a>
      <nav aria-label={copy.navigationLabel}>
        <a
          class="about-link"
          href={`${publishedPagePath('home', locale)}#how-it-works`}
        >
          {copy.howLink}
        </a>
        <div class="header-controls">
          {publishedLocales.length > 1 && (
            <details class="language-control">
              <summary aria-label={copy.languageLabel}>
                {locale.toUpperCase()}
              </summary>
              <ul>
                {publishedLocales.map((language) => (
                  <li>
                    <a
                      href={publishedPagePath(page, language)}
                      lang={language}
                      aria-current={language === locale ? 'page' : undefined}
                    >
                      {copy.languageNames[language]}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <ThemeToggle locale={locale} />
        </div>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>{copy.footer}</p>
      <a class="footer-github" href={repositoryUrl}>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          fill="currentColor"
        >
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.14c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a11 11 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.08 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.79.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
        </svg>
        {copy.github}
      </a>
      <p>
        {copy.footerCredit}{' '}
        <span class="footer-spark" aria-hidden="true">
          ✦
        </span>
      </p>
    </footer>
  </body>
</html>
