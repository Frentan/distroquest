---
import ThemeToggle from '../components/ThemeToggle.astro';
import BrandMark from '../components/BrandMark.astro';
import '../styles/global.css';
import {
  defaultLocale,
  getMessages,
  localePath,
  type PublishedLocale,
} from '../i18n';

interface Props {
  locale?: PublishedLocale;
  title: string;
  description: string;
  noindex?: boolean;
}
const {
  title,
  description,
  noindex = false,
  locale = defaultLocale,
} = Astro.props;
const copy = getMessages(locale).site;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48 64x64 128x128 256x256"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Before paint: storage may be unavailable, but the OS preference still works. -->
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem('distroquest-theme');
        } catch {}
        const theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.skipLink}
    </a>
    <header class="site-header container">
      <a
        class="brand"
        href={localePath('/', locale)}
        aria-label={copy.homeLabel}
      >
        <BrandMark />
        <span>
          {copy.wordmark[0]}
          <span class="brand-quest">{copy.wordmark[1]}</span>
          <span class="brand-dot">.</span>
        </span>
      </a>
      <nav aria-label={copy.navigationLabel}>
        <a class="about-link" href={`${localePath('/', locale)}#how-it-works`}>
          {copy.howLink}
        </a>
        <ThemeToggle locale={locale} />
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>{copy.footer}</p>
      <p>
        {copy.footerCredit}{' '}
        <span class="footer-spark" aria-hidden="true">
          ✦
        </span>
      </p>
    </footer>
  </body>
</html>
