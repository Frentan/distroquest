---
import DistroProfilePage from '../../../components/DistroProfilePage.astro';
import { distroProfiles } from '../../../data/distros';
export function getStaticPaths() {
  return distroProfiles.map((distro) => ({
    params: { slug: distro.slug },
    props: { id: distro.id },
  }));
}
const { id } = Astro.props;
---

<DistroProfilePage locale="pt" id={id} />
