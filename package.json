{
  "name": "distroquest",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none --test-reporter=spec tests/*.test.ts",
    "data:review": "node --experimental-strip-types scripts/review-distros.ts",
    "preferences:review": "node --experimental-strip-types scripts/review-preferences.ts",
    "dev": "astro dev",
    "dev:start": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
